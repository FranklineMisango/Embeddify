{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start backend (root-safe)",
			"type": "shell",
			"command": "uvicorn",
			"args": [
				"app.main:app",
				"--app-dir",
				"backend",
				"--host",
				"0.0.0.0",
				"--port",
				"8000",
				"--reload"
			],
			"isBackground": true,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		}
	]
}